{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "docs/custom-guidelines.md"
  ],
  "autoupdate": false,
  "agent": {
    "default": {
      "steps": 15
    }
  },
  "plugin": [
    "opencode-plugin-openspec"
  ],
  "lsp": {
     "python": {
        "command": ["pylsp"]
     },
     "java": {
        "command": ["/opt/jdtls/bin/jdtls"],
        "args": ["-data", "/workspace/.jdtls/workspace"],
        "initialization": {
          "settings": {
            "java": {
              "configuration": {
                "runtimes": [
                  { "name": "JavaSE-1.8", "path": "/usr/lib/jvm/java-8"  },
                  { "name": "JavaSE-11",  "path": "/usr/lib/jvm/java-11" },
                  { "name": "JavaSE-17",  "path": "/usr/lib/jvm/java-17" },
                  { "name": "JavaSE-21",  "path": "/usr/lib/jvm/java-21", "default": true },
                  { "name": "JavaSE-25",  "path": "/usr/lib/jvm/java-25" }
                ]
              }
            }
          }
        }
     }
  },
  "provider": {
    "vllm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "vLLM Server",
      "options": {
        "baseURL": "{env:CODE_LLM_API_BASE}",
        "apiKey": "{env:CODE_LLM_TOKEN}",
        "timeout": 600000,
        "chunkTimeout": 30000,
        "setCacheKey": true
      },
      "models": {
        "mistralai/ministral-14b-2512": {
          "name": "mistralai/ministral-14b-2512"
        },
        "mistralai/devstral-2512": {
          "name": "mistralai/devstral-2512"
        }
      }
    }
  },
  "model": "vllm/mistralai/devstral-2512"
}
